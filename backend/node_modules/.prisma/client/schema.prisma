datasource db {
  provider = "sqlite"
  url      = "file:./swasthya_setu.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         String // PATIENT, ASHA, DOCTOR, LAB, PHARMACY, ADMIN, DISTRICT_OFFICER
  facilityId   String?
  facility     Facility? @relation(fields: [facilityId], references: [id])
  abhaId       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  registeredPatients Patient[]           @relation("AshaRegisteredPatients")
  doctorAppointments Appointment[]       @relation("DoctorAppointments")
  consultations      Consultation[]      @relation("DoctorConsultations")
  prescriptions      Prescription[]      @relation("DoctorPrescriptions")
  orderedDiagnostics DiagnosticRequest[] @relation("DoctorDiagnostics")
  referralsCreated   Referral[]          @relation("ReferringDoctor")
  assignedFollowUps  FollowUp[]          @relation("AssignedAshaFollowups")
  notifications      Notification[]
  auditLogs          AuditLog[]
}

model Facility {
  id             String   @id @default(uuid())
  name           String
  type           String // SUB_CENTRE, PHC, RURAL_HOSPITAL, DISTRICT_HOSPITAL, SPECIALTY_HOSPITAL
  district       String   @default("Thane")
  address        String
  latitude       Float
  longitude      Float
  contactPhone   String
  bedCapacity    Int      @default(30)
  activeDoctors  Int      @default(4)
  activeServices String // JSON string of services e.g. ["OPD", "Telemedicine", "Diagnostics", "Pharmacy", "ANC Clinic"]
  createdAt      DateTime @default(now())

  users              User[]
  patients           Patient[]
  appointments       Appointment[]
  consultations      Consultation[]
  outgoingReferrals  Referral[]          @relation("OriginFacility")
  incomingReferrals  Referral[]          @relation("DestinationFacility")
  diagnosticRequests DiagnosticRequest[]
  medicines          Medicine[]
}

model Patient {
  id                 String    @id @default(uuid())
  patientId          String    @unique // e.g. MH-THN-10024
  name               String
  age                Int
  gender             String // Male, Female, Other
  phone              String
  village            String
  address            String
  emergencyContact   String
  pregnancyStatus    Boolean   @default(false)
  gestationalWeeks   Int?
  bloodGroup         String?
  chronicConditions  String? // JSON array or comma list e.g. "Gestational Hypertension, Anemia"
  allergies          String?
  registeredByAshaId String?
  registeredByAsha   User?     @relation("AshaRegisteredPatients", fields: [registeredByAshaId], references: [id])
  facilityId         String?
  facility           Facility? @relation(fields: [facilityId], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  healthRecords      HealthRecord[]
  vitals             Vital[]
  triageAssessments  TriageAssessment[]
  appointments       Appointment[]
  consultations      Consultation[]
  prescriptions      Prescription[]
  referrals          Referral[]
  diagnosticRequests DiagnosticRequest[]
  followUps          FollowUp[]
}

model HealthRecord {
  id         String   @id @default(uuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  category   String // Immunization, Past Encounter, Surgery, Allergy, Family History
  title      String
  details    String
  recordedBy String
  date       DateTime @default(now())
  createdAt  DateTime @default(now())
}

model Vital {
  id           String   @id @default(uuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  systolicBp   Int?
  diastolicBp  Int?
  heartRate    Int?
  spo2         Int?
  temperature  Float?
  bloodGlucose Float?
  weight       Float?
  recordedBy   String
  recordedRole String // ASHA, DOCTOR, NURSE
  notes        String?
  recordedAt   DateTime @default(now())
}

model TriageAssessment {
  id                String   @id @default(uuid())
  patientId         String
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  symptoms          String // JSON string of symptoms
  symptomDuration   String?
  ruleTriggered     String?
  riskLevel         String // ROUTINE, MODERATE, HIGH, EMERGENCY
  clinicalReasoning String
  recommendedAction String
  assessedBy        String
  assessedAt        DateTime @default(now())
}

model Appointment {
  id            String   @id @default(uuid())
  patientId     String
  patient       Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String?
  doctor        User?    @relation("DoctorAppointments", fields: [doctorId], references: [id])
  facilityId    String
  facility      Facility @relation(fields: [facilityId], references: [id])
  tokenNumber   String // e.g. A-024
  date          String // YYYY-MM-DD
  timeSlot      String // e.g. 10:30 AM
  queuePosition Int      @default(1)
  status        String   @default("WAITING") // WAITING, IN_PROGRESS, COMPLETED, CANCELLED, SKIPPED
  mode          String   @default("PHYSICAL") // PHYSICAL, TELECONSULTATION
  urgency       String   @default("ROUTINE") // ROUTINE, MODERATE, HIGH, EMERGENCY
  reason        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  consultations Consultation[]
}

model Consultation {
  id              String       @id @default(uuid())
  appointmentId   String?
  appointment     Appointment? @relation(fields: [appointmentId], references: [id])
  patientId       String
  patient         Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String
  doctor          User         @relation("DoctorConsultations", fields: [doctorId], references: [id])
  facilityId      String
  facility        Facility     @relation(fields: [facilityId], references: [id])
  chiefComplaints String
  clinicalNotes   String
  diagnosis       String
  assessment      String?
  followUpDate    String?
  createdAt       DateTime     @default(now())

  prescriptions Prescription[]
}

model Prescription {
  id             String        @id @default(uuid())
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id])
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String
  doctor         User          @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
  medicineName   String
  dosage         String // e.g. 500mg
  frequency      String // e.g. 1-0-1 After food
  durationDays   Int           @default(5)
  instructions   String?
  createdAt      DateTime      @default(now())
}

model Referral {
  id                    String   @id @default(uuid())
  patientId             String
  patient               Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  referringDoctorId     String?
  referringDoctor       User?    @relation("ReferringDoctor", fields: [referringDoctorId], references: [id])
  originFacilityId      String
  originFacility        Facility @relation("OriginFacility", fields: [originFacilityId], references: [id])
  destinationFacilityId String
  destinationFacility   Facility @relation("DestinationFacility", fields: [destinationFacilityId], references: [id])
  reason                String
  clinicalSummary       String
  priority              String   @default("HIGH") // ROUTINE, HIGH, EMERGENCY
  status                String   @default("CREATED") // CREATED, SENT, ACCEPTED, SCHEDULED, ARRIVED, CONSULTED, FOLLOWUP_REQUIRED, CLOSED
  trackingTimeline      String // JSON string of stage updates
  createdDate           DateTime @default(now())
  updatedDate           DateTime @updatedAt
}

model DiagnosticRequest {
  id                String    @id @default(uuid())
  patientId         String
  patient           Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId          String?
  doctor            User?     @relation("DoctorDiagnostics", fields: [doctorId], references: [id])
  facilityId        String
  facility          Facility  @relation(fields: [facilityId], references: [id])
  testName          String // CBC, Blood Glucose, Urine Routine/Protein, HbA1c, Ultrasound, Chest X-Ray
  testCategory      String // Pathology, Biochemistry, Radiology
  priority          String    @default("ROUTINE") // ROUTINE, HIGH, EMERGENCY
  status            String    @default("REQUESTED") // REQUESTED, SCHEDULED, SAMPLE_COLLECTED, PROCESSING, REPORT_READY, VERIFIED
  sampleCollectedAt DateTime?
  appointmentDate   String?
  reportUrl         String?
  reportFindings    String?
  normalRange       String?
  testValue         String?
  isAbnormal        Boolean   @default(false)
  verifiedBy        String?
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Medicine {
  id               String   @id @default(uuid())
  name             String
  genericName      String
  category         String // Maternal Health, Antibiotics, Antihypertensive, Antidiabetic, Analgesic, Pediatric
  strength         String // 500mg, 100mg, 5mg/ml
  dosageForm       String // Tablet, Capsule, Syrup, Injection
  facilityId       String
  facility         Facility @relation(fields: [facilityId], references: [id])
  quantity         Int      @default(0)
  reorderThreshold Int      @default(50)
  batchNumber      String
  expiryDate       String
  isAvailable      Boolean  @default(true)
  lastRestockedAt  DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model FollowUp {
  id               String   @id @default(uuid())
  patientId        String
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  assignedWorkerId String?
  assignedWorker   User?    @relation("AssignedAshaFollowups", fields: [assignedWorkerId], references: [id])
  category         String // MATERNAL_ANC, CHILD_IMMUNIZATION, CHRONIC_DISEASE, POST_REFERRAL, SURGICAL_RECOVERY
  description      String
  dueDate          String // YYYY-MM-DD
  completedDate    String?
  status           String   @default("PENDING") // PENDING, OVERDUE, COMPLETED, CANCELLED
  priority         String   @default("ROUTINE") // ROUTINE, HIGH, CRITICAL
  aiRiskScore      Float? // 0.0 to 1.0 (Predicted probability of miss/risk)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  type      String // APPOINTMENT, REFERRAL, DIAGNOSTIC, MEDICINE, FOLLOWUP, HIGH_RISK, EMERGENCY, SYNC
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  userName  String
  userRole  String
  action    String // VIEW_RECORD, UPDATE_VITALS, CREATE_REFERRAL, VERIFY_REPORT, RESTOCK_MEDICINE, TRIAGE_SCREENING
  entity    String // Patient, Vital, Referral, Diagnostic, Medicine
  entityId  String?
  details   String
  ipAddress String   @default("127.0.0.1")
  timestamp DateTime @default(now())
}
